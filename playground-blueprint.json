{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/post.php?post=4&action=edit",
  "login": true,
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://github.com/gbyat/we-icon-blocks/releases/download/v0.2.21/we-icon-blocks.zip"
      }
    },
    {
      "step": "activatePlugin",
      "pluginName": "WE Icon Blocks",
      "pluginPath": "we-icon-blocks/we-icon-blocks.php"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "WE Icon Blocks Demo"
      }
    },
    {
      "step": "importWxr",
      "file": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/gbyat/we-icon-blocks/main/playground-demo-content.xml"
      }
    }
  ]
}
